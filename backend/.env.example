# Heist Backend - Environment Variable Template
# Copy this file to .env and fill in real values.

PORT=5000
HOST=0.0.0.0
FLASK_ENV=development

SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING

CONFIG_PATH=config/game_settings.json

CF_ACCOUNT_ID=
CF_API_TOKEN=

CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# ---------------------------------------------------------------------------
# Supabase. The ML service verifies crew JWTs against SUPABASE_JWT_SECRET and
# reports machine-graded results with the service role key.
# Get these from: Supabase dashboard > Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Must match TEAM_EMAIL_DOMAIN in supabase/functions/.env and the frontend's
# VITE_TEAM_EMAIL_DOMAIN, or crew tokens will not resolve to a team.
TEAM_EMAIL_DOMAIN=louvre.local
