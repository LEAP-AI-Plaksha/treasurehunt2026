# Heist Backend - Environment Variables

# Server
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development

# Flask secret key - change this to a long random string before deploying
SECRET_KEY=heist-super-secret-key-change-me

# Path to centralized game config (relative to backend/)
CONFIG_PATH=config/game_settings.json

# Cloudflare Workers AI (used by Memory-to-Image room)
CF_ACCOUNT_ID=--
CF_API_TOKEN=--

# CLIP / image scoring model
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
