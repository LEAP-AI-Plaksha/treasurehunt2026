# ---------------------------------------------------------------------------
# Kiosk frontend configuration
# Copy to .env.local on each machine and set VITE_ROOM_ID to that room.
# ---------------------------------------------------------------------------

# Which room this terminal is. One of:
#   YOGA_ROOM | CTLC_LAB | MUSIC_ROOM | H2_LOUNGE | CLASSROOM_1101 | NOSE_DRAW
# The hub terminal uses HUB.
VITE_ROOM_ID=YOGA_ROOM

# Supabase project. Local dev values come from `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Must match TEAM_EMAIL_DOMAIN in supabase/functions/.env, or logins will not
# resolve to the right crew.
VITE_TEAM_EMAIL_DOMAIN=louvre.local

# Flask ML service, for the pose / CLIP / image-generation rooms only.
# Left as /api so Vite's dev proxy forwards it.
VITE_ML_BASE_URL=/api

# ---------------------------------------------------------------------------
# HUB TERMINAL ONLY - do not set these on a room kiosk.
# This key can read every crew's times and reset passcodes.
# ---------------------------------------------------------------------------
# VITE_OPERATOR_KEY=

# Flask ML service on this same machine, proxied as /api. Only the YOGA_ROOM and
# H2_LOUNGE devices run it; harmless everywhere else. Port 4000, not 5000 - on
# macOS the AirPlay Receiver holds 5000.
VITE_API_BASE_URL=http://localhost:4000
