# ---------------------------------------------------------------------------
# Supabase backend
# ---------------------------------------------------------------------------
.venv/

# Local CLI state, not project source
supabase/.branches/
supabase/.temp/

# Edge function secrets. The .example templates above are safe to track;
# the real file holds the operator key and must never be committed.
supabase/functions/.env

# The Python rules above ignore any directory named `lib`, which would also
# swallow the frontend's src/lib (the Supabase client lives there). Re-include it.
!**/src/lib/
!**/src/lib/**

# Keep the env templates: they document required keys and contain no secrets.
!*.env.example
!.env.example

# Generated credential sheet - the one real secret in this repo.
team-credentials.txt

# Runtime artefacts from the Memory Forgery room: photos fetched from the
# internet per round, and the images Cloudflare generates from crew
# descriptions. Written by backend/app.py at play time, never source.
backend/static/generated/
backend/static/images/online/
