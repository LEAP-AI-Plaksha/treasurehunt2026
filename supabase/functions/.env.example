# Secrets for the edge functions.
# Local dev: copy to supabase/functions/.env (gitignored) and adjust.
# Production: push with `supabase secrets set --env-file supabase/functions/.env`
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically and must
# NOT be listed here.

# Synthetic login domain for crews. Never receives mail; it exists so Supabase
# Auth can issue each crew a normal JWT. ALPHA -> alpha@louvre.local
TEAM_EMAIL_DOMAIN=louvre.local

# Shared secret the hub terminal sends as the x-operator-key header. Anyone with
# this can read every team's times and reset passcodes - keep it off the kiosks.
OPERATOR_KEY=CHANGE_ME_LONG_RANDOM_STRING

# Comma-separated origins allowed to call these functions: the hub plus each
# room frontend. Leave empty ONLY in local development.
ALLOWED_ORIGINS=http://localhost:5172,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178
